# Local-only settings. Copy to .env if you need overrides.
DB_MODE=sqlite
PORT=5000
RF_WEIGHT=0.8
CF_WEIGHT=0.2

# Optional IMD API authentication settings. Leave unset unless you have access.
# IMD_API_AUTH_HEADER=
# IMD_API_AUTH_VALUE=
# IMD_API_TIMEOUT=5
# IMD_CACHE_SECONDS=900

# Optional MySQL settings; SQLite is the default and needs no credentials.
# DB_MODE=mysql
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=
# MYSQL_USER=
# MYSQL_PASSWORD=
